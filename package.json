{
	"name": "perf-action",
	"type": "module",
	"version": "0.0.1",
	"main": "dist/index.js",
	"scripts": {
		"build": "bun run clean && bun build ./src/index.ts --target=node --outdir=dist && cp -r static dist/static",
		"clean": "rm -rf ./dist",
		"-        ": "",
		"format": "prettier --check . --ignore-path .gitignore",
		"format:fix": "prettier --write . --ignore-path .gitignore",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"tsc": "tsc --noEmit",
		"-      ": "",
		"test": "NODE_ENV=test vitest run",
		"test:coverage": "NODE_ENV=test vitest run --coverage",
		"test:update": "NODE_ENV=test vitest run --update",
		"test:watch": "bun codegen -- -w && NODE_ENV=test vitest dev"
	},
	"dependencies": {
		"@actions/core": "^1.11.1",
		"@actions/github": "^6.0.1"
	},
	"devDependencies": {
		"@tsconfig/strictest": "^2.0.5",
		"@types/bun": "^1.2.15",
		"@vitest/coverage-v8": "^2.1.3",
		"eslint": "^8",
		"eslint-config-ixn": "^1.5.3",
		"prettier": "^3.3.3",
		"typescript": "^5.6.2",
		"vitest": "^2.1.3"
	}
}
